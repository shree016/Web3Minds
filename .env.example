# Web3Minds Environment Variables
# Copy this file to .env.local and fill in your keys

# Supabase (free tier — get from supabase.com)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini AI (free tier — get from aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key

# WalletConnect (optional — get from cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
